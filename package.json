{
  "name": "hydrowf-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The hydrowf-studio page: plain JavaScript, bundled by esbuild into the Tethys app's public folder",
  "scripts": {
    "build": "esbuild frontend/src/main.js --bundle --format=iife --target=es2022 --minify --sourcemap --outfile=tethysapp/hydrowf_studio/public/frontend/studio.js",
    "watch": "esbuild frontend/src/main.js --bundle --format=iife --target=es2022 --sourcemap --outfile=tethysapp/hydrowf_studio/public/frontend/studio.js --watch",
    "test": "node --test \"frontend/test/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
